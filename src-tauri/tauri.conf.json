{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clavis",
  "version": "0.4.1",
  "identifier": "app.clavis.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRjM3Mzg1MEY5N0VBMUUKUldRZTZwY1BoWFB6L29YVkxEeEZnMFJuMUFScHBoL1VoVThSaDV3TXR4U09KQkMyTERxN01hakYK",
      "endpoints": [
        "https://github.com/Minorq5/clavis/releases/latest/download/latest.json",
        "https://zjoctahbygocbbzeqvor.supabase.co/storage/v1/object/public/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}